# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Android native build artifacts (the android/ project itself is committed)
android/build/
android/app/build/
android/.gradle/
android/local.properties

# User-supplied copyrighted Bible translation JSONs (never commit)
bibles-private/

# Public-domain canonical JSONs consumed by build-bible-db (generated out-of-band)
bibles-canonical/

# Prebuilt Bible asset emitted by `npm run build-bible-db` (build artifact)
public/assets/databases/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
*.local
.vscode/*
!.vscode/extensions.json
.idea

# Claude Code personal overrides
.claude/settings.local.json

# Signing secrets — never commit
android/keystore.properties
*.keystore
*.jks
